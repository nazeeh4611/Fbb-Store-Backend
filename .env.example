# --- required ---
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/fbb   # must be a replica set (Atlas is fine) - orders use transactions
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=production
PORT=3000

# Comma-separated list of allowed storefront origins
CORS_ORIGINS=https://flybuybrand.com,https://www.flybuybrand.com,https://fbb-store-e-commerce.vercel.app

# --- payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=        # webhook URL: https://<api-host>/api/webhook/razorpay

# --- email (Resend) ---
RESEND_API_KEY=

# --- images (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- optional ---
GOOGLE_CLIENT_ID=418114033455-nu2odpsacsi4vb0sjrgsoebqcpfb9ai9.apps.googleusercontent.com
ADMIN_SETUP_KEY=                # lets you create extra admins via POST /api/admin/register {setupKey}
CACHE_CLEAR_KEY=
